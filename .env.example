# ===================================================================
# STOCKPRO — CONFIGURATION D'ENVIRONNEMENT (PRODUCTION / DÉVELOPPEMENT)
# ===================================================================

# 1. SÉCURITÉ JWT (OBLIGATOIRE EN PRODUCTION)
# Clé secrète cryptographique pour signer les jetons d'authentification.
# DOIT comporter au moins 24 caractères (idéalement 64 caractères aléatoires).
# Exemple de génération : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="stockpro-prod-secret-changez-cette-cle-par-une-cle-tres-longue-et-aleatoire-2026"
JWT_EXPIRES_IN="7d"

# 2. COMPTE ADMINISTRATEUR PRINCIPAL
# Ce compte est automatiquement créé au démarrage s'il n'existe pas encore.
ADMIN_EMAIL="admin@stockpro.ci"
ADMIN_PASSWORD="StockProAdmin2026!ChangezMoi"
ADMIN_NAME="Administrateur StockPro"

# Forcer la réinitialisation du mot de passe admin au prochain redémarrage :
# Mettre à "true" UNE SEULE FOIS si vous perdez le mot de passe admin, puis remettre à "false".
ADMIN_RESET_PASSWORD="false"

# 3. CONFIGURATION SERVEUR ET MISE EN LIGNE
# Port d'écoute (injecté automatiquement par Render, Railway, Heroku, etc.)
PORT=4000

# "production" pour la mise en ligne, "development" pour les tests locaux
NODE_ENV="production"

# URL publique de votre application (ex: https://stockpro.ci ou https://mon-stockpro.onrender.com)
# Permet de configurer CORS et les redirections derrière Nginx / Caddy / Cloudflare.
# Plusieurs domaines peuvent être séparés par des virgules : "https://stockpro.ci,https://admin.stockpro.ci"
APP_URL="https://stockpro.ci"

# 4. PERSISTANCE DES DONNÉES
# Chemin vers le fichier de stockage JSON (optionnel, par défaut : data/stockpro-db.json).
# Sur un serveur avec volume persistant (ex: Render Disks, Railway Volume, Docker) :
# DATABASE_PATH="/var/data/stockpro-db.json"
